{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short.local/schema/storyboard.schema.json",
  "title": "Heritage Short Storyboard Contract",
  "description": "Single source of truth between script, keyframes, moving shots, music, narration, and FFmpeg assembly.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "style_block",
    "character_sheet",
    "music",
    "narration",
    "end_card",
    "shots"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": [
        "title",
        "logline",
        "treatment",
        "language",
        "subtitle_language",
        "target_duration_sec",
        "audience",
        "intent",
        "end_card_text",
        "ai_disclosure"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "logline": { "type": "string", "minLength": 10, "maxLength": 300 },
        "treatment": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "language": { "type": "string", "minLength": 2, "maxLength": 40 },
        "subtitle_language": { "type": "string", "minLength": 2, "maxLength": 40 },
        "target_duration_sec": { "type": "number", "minimum": 60, "maximum": 90 },
        "audience": { "type": "string", "minLength": 5, "maxLength": 400 },
        "intent": { "type": "string", "minLength": 5, "maxLength": 400 },
        "end_card_text": { "type": "string", "minLength": 5, "maxLength": 240 },
        "ai_disclosure": { "type": "boolean", "const": true }
      }
    },
    "style_block": {
      "type": "object",
      "required": ["prompt_prefix", "palette", "lighting", "medium", "negative_prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt_prefix": { "type": "string", "minLength": 10 },
        "palette": { "type": "string", "minLength": 5 },
        "lighting": { "type": "string", "minLength": 5 },
        "medium": { "type": "string", "minLength": 5 },
        "negative_prompt": { "type": "string" }
      }
    },
    "character_sheet": {
      "type": "object",
      "required": ["character_id", "name", "description", "is_real_person", "consent_verified", "reference_prompts", "reference_seed"],
      "additionalProperties": false,
      "properties": {
        "character_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 15 },
        "is_real_person": { "type": "boolean" },
        "consent_verified": { "type": "boolean" },
        "reference_prompts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 10 }
        },
        "reference_seed": { "type": "integer", "minimum": 0 },
        "approved_reference": { "type": ["string", "null"] }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "provider",
        "caption",
        "tempo_bpm",
        "key",
        "instrumental",
        "duration_sec",
        "candidates",
        "chosen_candidate_index",
        "cues"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["ace-step", "mock"] },
        "caption": { "type": "string", "minLength": 10 },
        "lyrics": { "type": "string" },
        "tempo_bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string", "minLength": 2, "maxLength": 30 },
        "instrumental": { "type": "boolean" },
        "duration_sec": { "type": "number", "minimum": 20, "maximum": 120 },
        "candidates": { "type": "integer", "minimum": 1, "maximum": 8 },
        "chosen_candidate_index": { "type": "integer", "minimum": 0, "maximum": 7 },
        "base_seed": { "type": "integer", "minimum": 0, "default": 4200 },
        "selection_reason": { "type": "string" },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "start_sec", "end_sec", "emotion", "notes"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 1 },
              "emotion": { "type": "string", "minLength": 2 },
              "notes": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "required": ["provider", "voice", "style_instruction", "language_code"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["gemini-tts", "mock"] },
        "voice": { "type": "string", "minLength": 1 },
        "style_instruction": { "type": "string", "minLength": 3 },
        "language_code": { "type": "string", "minLength": 2, "maxLength": 16 },
        "is_cloned_voice": { "type": "boolean", "default": false },
        "consent_verified": { "type": "boolean", "default": false }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["enabled", "duration_sec", "title", "disclosure_text"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "duration_sec": { "type": "number", "minimum": 1.5, "maximum": 5.0 },
        "title": { "type": "string", "minLength": 2 },
        "disclosure_text": { "type": "string", "minLength": 4 },
        "credits": { "type": "string" }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scene",
          "shot_size",
          "camera_movement",
          "duration_sec",
          "reason",
          "keyframe_prompt",
          "motion_prompt",
          "seed",
          "narration_line",
          "subtitle_en"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^shot_[0-9]{2}$" },
          "scene": { "type": "string", "minLength": 2 },
          "shot_size": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close_up",
              "close_up",
              "extreme_close_up",
              "insert"
            ]
          },
          "camera_movement": {
            "type": "string",
            "enum": [
              "static",
              "slow_push_in",
              "slow_pull_out",
              "pan_left",
              "pan_right",
              "tilt_up",
              "tilt_down",
              "dolly_in",
              "ken_burns"
            ]
          },
          "fallback_motion": {
            "type": "string",
            "enum": ["static", "zoom_in", "zoom_out", "pan_left", "pan_right"],
            "default": "zoom_in"
          },
          "duration_sec": { "type": "number", "minimum": 3.0, "maximum": 12.0 },
          "reason": { "type": "string", "minLength": 8 },
          "keyframe_prompt": { "type": "string", "minLength": 12 },
          "motion_prompt": { "type": "string", "minLength": 8 },
          "seed": { "type": "integer", "minimum": 0 },
          "narration_line": { "type": "string", "minLength": 2 },
          "subtitle_en": { "type": "string", "minLength": 2 },
          "video_backend": {
            "type": "string",
            "enum": ["auto", "wan22", "hunyuan", "ken_burns"],
            "default": "auto"
          },
          "trim_start_sec": { "type": "number", "minimum": 0, "default": 0 },
          "trim_end_sec": { "type": "number", "minimum": 0, "default": 0 }
        }
      }
    }
  }
}
