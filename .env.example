# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# Pipeline execution mode:
#   auto = use live APIs when keys are present, fall back gracefully to local/mock otherwise
#   live = require live APIs (fails fast if keys are missing)
#   mock = deterministic offline mode for testing and CI
PIPELINE_MODE=auto

# Google Gemini API (Script, Storyboard, Translation, Gemini 3.8 Flash TTS)
# Get free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Cloudflare Workers AI (FLUX.2 klein / FLUX.1 schnell keyframes)
# Get Account ID and API Token at https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Hugging Face / Gradio Space endpoints for remote Wan 2.2 / ACE-Step 1.5
HF_TOKEN=
WAN_SPACE_URL=
ACESTEP_SPACE_URL=

# Optional: Kaggle API (for downloading notebook outputs)
KAGGLE_USERNAME=
KAGGLE_KEY=
